# =====================================================================
#  Configuración local de "agentes". PLANTILLA: copiala como .env y completá las claves.
#  Generar cada clave:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#  N8N_ENCRYPTION_KEY: en una instalación nueva, cualquier valor largo; si ya tenés datos de n8n,
#  usá el "encryptionKey" de n8n/n8n_data/config.
# =====================================================================

# ---------- n8n ----------
# Clave que cifra las credenciales guardadas en n8n (NVIDIA, Ollama). Si se pierde, hay que volver a cargarlas.
N8N_ENCRYPTION_KEY=cambiar-por-un-valor-largo-y-aleatorio
# Token entre n8n y sus task runners (nodos Code)
N8N_RUNNERS_AUTH_TOKEN=cambiar-por-un-valor-largo-y-aleatorio
TZ=America/Argentina/Buenos_Aires

# ---------- Seguridad: claves de cada servicio ----------
# La API key de NVIDIA NO va acá: se carga en n8n como credencial "OpenAI account"
# (Base URL https://integrate.api.nvidia.com/v1) y queda cifrada con N8N_ENCRYPTION_KEY.
# Webhooks de n8n (orquestador, agente-especialista, estado-modelos): header X-API-Key
N8N_WEBHOOK_TOKEN=cambiar-por-un-valor-largo-y-aleatorio
# Servidor MCP (mcp-tools): header Authorization: Bearer / X-API-Key, o ?key= (lo usa n8n)
MCP_API_KEY=cambiar-por-un-valor-largo-y-aleatorio
# doc-service: header X-API-Key para generar documentos (las descargas /files siguen libres en localhost)
DOC_SERVICE_API_KEY=cambiar-por-un-valor-largo-y-aleatorio
# Web local: clave para entrar a la interfaz (se pide una vez en el navegador)
WEB_ACCESS_TOKEN=cambiar-por-un-valor-largo-y-aleatorio
# Web local: token con el que n8n y el MCP envían el progreso (POST /api/eventos)
WEB_EVENTOS_TOKEN=cambiar-por-un-valor-largo-y-aleatorio

# ---------- Red / puertos (en el host) ----------
# 127.0.0.1 = solo esta PC. Poné 0.0.0.0 únicamente si sabés lo que hacés (expone los servicios a la red).
BIND_IP=127.0.0.1
N8N_PORT=5678
DOC_SERVICE_PORT=8090
MCP_PORT=8092
WEB_PORT=8095

# ---------- URLs ----------
# Ollama corre en Windows; desde Docker se llega por la IP del host (IPv4). Depende de la PC:
# en Docker Desktop suele ser 192.168.65.254 (o probá http://host.docker.internal:11434).
# Ojo: n8n usa la URL de su credencial "Ollama account"; si la cambiás acá, cambiala también ahí.
OLLAMA_URL=http://192.168.65.254:11434
# URL pública (desde el navegador) de los archivos que genera doc-service
DOC_PUBLIC_URL=http://localhost:8090
# URLs internas entre contenedores (red agentes_default)
DOC_SERVICE_URL=http://doc-service:8090
MCP_URL=http://mcp-tools:8092/mcp
WEB_EVENTOS_URL=http://orquestador-web:8095/api/eventos
N8N_INTERNAL_URL=http://n8n-container:5678
